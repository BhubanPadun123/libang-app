# Backend selection (see src/services/api.ts):
# - Release builds use https://www.libangexpress.in.
# - In development the app tries your local backend (http://<Metro host>:3000) and
#   falls back to https://www.libangexpress.in when it isn't reachable.
# Set this to always use one backend, e.g. a teammate's machine or staging:
# EXPO_PUBLIC_API_URL=http://192.168.1.15:3000

# WebSocket endpoint for live order alerts and single-device sign-in.
# Defaults to the API URL with ws(s):// and the /ws path.
# EXPO_PUBLIC_WS_URL=wss://realtime.example.com/ws
