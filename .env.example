# Base URL of the Next.js backend. Leave unset in development to use
# http://<your machine's IP>:3000 (the same host Metro is served from).
# EXPO_PUBLIC_API_URL=http://192.168.1.15:3000

# WebSocket endpoint for live order alerts and single-device sign-in.
# Defaults to the API URL with ws:// and the /ws path.
# EXPO_PUBLIC_WS_URL=ws://192.168.1.15:3000/ws
